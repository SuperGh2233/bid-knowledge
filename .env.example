# bid-ai-clean 环境变量模板 —— 复制为 .env 后填值（.env 含真实 key，**禁止提交**）
# 全部开关默认值即「安全态」：四个外发/外部程序硬开关全 false，未授权路径明确 403。

# —— 数据与库 ——
# 测试/演示用 bid_ai_clean_reg.db；正式库 bid_ai_clean.db **禁写**（脚本层直接拒绝）
BID_AI_CLEAN_DB=./bid_ai_clean_reg.db
# NAS 数据源（只读，禁写），多个用系统路径分隔符（Windows 为 ;）
SOURCE_ROOTS=Z:\01 投标项目文件\2025年;Z:\01 投标项目文件\2026年

# —— Elasticsearch（BM25-only，不引入 embedding/kNN）——
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX_SCHEME=bid_scheme_sections_v1

# —— LLM 网关（外发；授权见 docs/authorizations/，范围不可自行扩大）——
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# —— 外发/外部程序硬开关（默认全 false；开启前须有对应书面授权）——
# 白名单 OCR 外发（本地后端 OCR_BACKEND=local 零外发、不受此闸约束）
OCR_ENABLED=false
OCR_BACKEND=local
# 方案生成外发正文（docs/authorizations/llm-generation-authorization.md）
PROPOSAL_GEN_ENABLED=false
# 查询意图识别 LLM 兜底（只发用户那一句查询；llm-intent-authorization.md）
INTENT_LLM_ENABLED=false
# /api/open 在服务端机器启动外部程序（仅限回环访问）
OPEN_EXTERNAL_ENABLED=false

# —— 业务口径开关 ——
# 明细金额「数量×单价」推导（默认开；回退 false 恢复旧口径，见 MINIMAL_REBUILD_PLAN §2 修订）
CONTRACT_DERIVE_AMOUNT=true
